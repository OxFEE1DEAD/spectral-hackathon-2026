# Build output
bin/
*.o

# Measurement output. The raw per-message samples are hundreds of megabytes per
# configuration and are not committed. The per-arm summaries the notebook reads are
# kilobytes and are committed, so every figure can be regenerated and diffed.
data/*
!data/ab_*/
!data/sweep_*/
*.json.gz

# Capture files never belong in this repository.
*.pcap
*.pcapng

# Local bench configuration: hostnames, addresses and interface names of the
# machines you measure on. Never committed -- see scripts/bench.env.example.
scripts/bench.env

# Jupyter writes these next to the notebook.
.ipynb_checkpoints/

# Python bytecode from running the aggregation scripts.
__pycache__/
*.pyc

# Measurement tool binaries.
tools/bin/

# Local Python environment, and Terraform's local state and lock file: state names
# live AWS resources and does not belong in a repository.
.venv/
results/
infra/.terraform/
infra/*.tfstate*
infra/.terraform.lock.hcl

# Рабочий план, не для сдачи.
PLAN.tmp.md
