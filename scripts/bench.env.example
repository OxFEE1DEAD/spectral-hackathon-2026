# Bench topology for the fan-out transport.
#
# Copy to bench.env (gitignored) and fill in for your own machines:
#
#   cp scripts/bench.env.example scripts/bench.env
#
# Nothing in this file is baked into the binaries -- sender and receiver take
# every address, port and core on the command line. This file only saves you
# retyping them, and keeps host-specific detail out of the repository.

# Host that runs the producer and the sender.
SENDER_HOST=<sender-host-or-ip>

# Host that runs the receiver and the consumer. One entry per receiver for
# fan-out runs, space separated.
RECEIVER_ADDRS="<receiver-ip>"

# NIC used for the measured path, on both hosts. Used only by the host-tuning
# script; the transport itself binds by address, not by interface name.
IFACE=<nic-interface>

# UDP port for the data path.
PORT=51000

# Cores to pin the spinning threads to. These must be isolated cores
# (isolcpus/nohz_full/rcu_nocbs) that nothing else runs on, and they must be
# distinct physical cores -- see harness/README.md for the boot-time setup.
PRODUCER_CORE=1
SENDER_CORE=2
RECEIVER_CORE=3
CONSUMER_CORE=4
